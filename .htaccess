# Subdomínio blackfriday.rainhadoscompressores.com.br
# Página estática: não herda as regras do WordPress do site principal (pasta /www).
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine Off
</IfModule>

# Não expor os arquivos internos do Git
<FilesMatch "^\.git">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
